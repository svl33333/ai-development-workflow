{
  "type": "object",
  "required": ["unit_id", "run_id", "generation", "base_revision", "status", "commit", "tests", "local_review", "artifact_digest"],
  "properties": {
    "unit_id": {"type": "string"},
    "run_id": {"type": "string"},
    "generation": {"type": "integer"},
    "base_revision": {"type": "string"},
    "status": {"enum": ["SUCCEEDED", "FAILED", "BLOCKED", "CANCELLED"]},
    "commit": {"type": ["string", "null"]},
    "tests": {"type": "object"},
    "local_review": {
      "type": "object",
      "required": ["reviewer", "reviewed_revision", "findings", "blocking_count", "disposition"],
      "properties": {
        "reviewer": {"type": "string"},
        "reviewed_revision": {"type": "string"},
        "findings": {"type": "array"},
        "blocking_count": {"type": "integer"},
        "disposition": {"enum": ["approved", "changes_required"]}
      }
    },
    "artifact_digest": {"type": "string"}
  }
}
