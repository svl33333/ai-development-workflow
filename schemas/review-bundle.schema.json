{
  "$id": "review-bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hash_algorithm", "task_id", "issue_id", "base_revision", "target_revision", "implementation_revision", "review_revision", "iteration", "conversation", "project", "inputs", "allowed_metadata_commits", "path_scope", "expected_change_scope", "work_identity", "presentation_target", "approval_receipt", "presentation_receipt", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "hash_algorithm": {"const": "sha256"},
    "task_id": {"type": "string", "minLength": 1},
    "issue_id": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "minLength": 7},
    "target_revision": {"type": "string", "minLength": 7},
    "implementation_revision": {"type": "string", "minLength": 7},
    "review_revision": {"type": "string", "minLength": 7},
    "iteration": {"type": "integer", "minimum": 1},
    "conversation": {"type": "object", "required": ["identity", "role"], "properties": {"identity": {"type": "string", "minLength": 1}, "role": {"const": "review"}}, "additionalProperties": false},
    "project": {"type": "object", "required": ["identity", "workspace", "repository"], "properties": {"identity": {"type": "string", "minLength": 1}, "workspace": {"type": "string", "minLength": 1}, "repository": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "revision", "artifact_class", "hash_basis", "digest", "byte_length", "git_object_id"], "properties": {"path": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 7}, "artifact_class": {"type": "string", "minLength": 1}, "hash_basis": {"enum": ["working_tree_bytes", "canonical_utf8"]}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "byte_length": {"type": "integer", "minimum": 0}, "git_object_id": {"type": "object", "required": ["algorithm", "basis", "value"], "properties": {"algorithm": {"enum": ["git-sha1", "git-sha256"]}, "basis": {"const": "git_object_id"}, "value": {"if": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "then": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "else": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "allOf": [{"if": {"properties": {"algorithm": {"const": "git-sha1"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}}}, {"if": {"properties": {"algorithm": {"const": "git-sha256"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}], "additionalProperties": false}}, "additionalProperties": false}},
    "allowed_metadata_commits": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 7}},
    "allowed_metadata_revision": {"type": "string", "minLength": 1},
    "path_scope": {"type": "object", "additionalProperties": false, "required": ["input_paths", "implementation_paths", "metadata_paths"], "properties": {"input_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "implementation_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "metadata_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "expected_change_scope": {"type": "object", "additionalProperties": false, "required": ["implementation_paths", "metadata_paths"], "properties": {"implementation_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "metadata_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "work_identity": {"type": "object", "additionalProperties": false, "required": ["task_id", "issue_id", "project_identity", "workspace", "repository", "branch", "generation"], "properties": {"task_id": {"type": "string", "minLength": 1}, "issue_id": {"type": "string", "minLength": 1}, "project_identity": {"type": "string", "minLength": 1}, "workspace": {"type": "string", "minLength": 1}, "repository": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1}}},
    "presentation_target": {"type": "object", "additionalProperties": false, "required": ["revision", "artifact_digest"], "properties": {"revision": {"type": "string", "minLength": 7}, "artifact_digest": {"type": "string", "minLength": 1}}},
    "approval_receipt": {"type": "object", "required": ["digest", "type", "revision"], "properties": {"digest": {"type": "string", "minLength": 1}, "type": {"const": "human_approval"}, "revision": {"type": "string", "minLength": 7}}, "additionalProperties": false},
    "presentation_receipt": {"type": "object", "required": ["digest", "artifact_digest", "type"], "properties": {"digest": {"type": "string", "minLength": 1}, "artifact_digest": {"type": "string", "minLength": 1}, "type": {"const": "human_presentation"}}, "additionalProperties": false},
    "bundle_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
